#!/bin/sh
# Boot the Pulsar II and keep running as the DSP daemon (pulsard), started by snd-pulsar@.service as root.
# pulsard restores the saved mixer levels itself once the card (and its controls) are up.
set -e
: "${PULSAR_DSP_DIR:=/var/lib/snd-pulsar/dsp}"
export PULSAR_DSP_DIR
# shellcheck disable=SC2086
exec python3 -I /usr/lib/snd-pulsar/tools/pulsard.py --resource "$1" --dsp-dir "$PULSAR_DSP_DIR" $PULSAR_ARGS
