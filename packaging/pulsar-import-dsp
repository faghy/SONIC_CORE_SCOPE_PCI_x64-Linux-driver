#!/bin/sh
# Import the Sonic Core DSP files needed by the Pulsar II driver (they are not redistributable).
#
#   sudo pulsar-import-dsp SONIC_CORE_SCOPE_PCI_v5.1.2709-x64_EN.exe
#   sudo pulsar-import-dsp /path/to/extracted/app/App/Dsp
set -e
DSP_DIR=/var/lib/snd-pulsar/dsp
SRC="$1"
[ "$(id -u)" = 0 ] || { echo "run as root: sudo $0 $*"; exit 1; }
[ -n "$SRC" ] || { sed -n '2,6p' "$0"; exit 1; }
tmp=""
case "$SRC" in
*.exe|*.EXE)
	command -v innoextract >/dev/null || { echo "innoextract is needed: sudo apt install innoextract"; exit 1; }
	tmp=$(mktemp -d)
	echo "extracting $SRC ..."
	innoextract -q -d "$tmp" "$SRC"
	SRC="$tmp/app/App/Dsp"
	;;
esac
[ -f "$SRC/puls2os0.21k" ] || { echo "no SCOPE DSP files (puls2os0.21k) in $SRC"; [ -n "$tmp" ] && rm -rf "$tmp"; exit 1; }
mkdir -p "$DSP_DIR"
cp -a "$SRC"/. "$DSP_DIR"/
[ -n "$tmp" ] && rm -rf "$tmp"
rm -rf /var/cache/pulsard
echo "$(ls "$DSP_DIR" | wc -l) DSP files imported into $DSP_DIR"
# start (or restart) the card service if the card is present
for dev in /dev/snd/hwC*D0; do
	[ -e "$dev" ] || continue
	unit="snd-pulsar@$(basename "$dev").service"
	if udevadm info -q property -n "$dev" 2>/dev/null | grep -q 'SYSTEMD_WANTS=.*snd-pulsar'; then
		systemctl restart "$unit" && echo "started $unit"
	fi
done
